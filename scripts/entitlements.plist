<?xml version="1.0" encoding="UTF-8"?>
<!--
  Entitlements for the bundled Python runtime under the hardened runtime, which
  notarisation requires.

  Both of these are needed because of how the helper reaches the cutter:

  - disable-library-validation: the interpreter dlopen()s libusb through ctypes.
    Library validation would only permit libraries signed by the same Team ID or
    by Apple, and would reject it.

  - allow-unsigned-executable-memory: CPython's ctypes builds and calls foreign
    function trampolines at runtime, which the hardened runtime blocks by
    default.

  Nothing here weakens the sandbox for the user's other software; entitlements
  apply only to the signed binary that carries them.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
