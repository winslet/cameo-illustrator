# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
.pytest_cache/

# Created by scripts/dev-install.sh: a symlink to ../helper so that the panel's
# <extension>/helper lookup works in development as well as when packaged.
cep/helper

# CEP debug descriptor, generated per-machine by dev-install.sh
cep/.debug

# Build output and downloaded build tools (ZXPSignCmd, Python runtimes,
# the self-signed certificate — never commit a signing key).
dist/
.tools/

# Third-party Python packages, regenerated by scripts/vendor-pydeps.sh.
# Not committed: they are upstream artefacts, unlike helper/vendor/silhouette
# which is deliberately pinned in-tree.
helper/vendor/pydeps/

# macOS
.DS_Store
