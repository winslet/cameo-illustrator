root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{js,jsx,json,yml,yaml,html,css}]
indent_size = 2

[*.sh]
indent_size = 2

# The vendored driver is kept byte-identical to upstream; do not let an editor
# reformat it. See helper/vendor/VENDOR.md.
[helper/vendor/**]
trim_trailing_whitespace = false
insert_final_newline = false

[*.md]
trim_trailing_whitespace = false
